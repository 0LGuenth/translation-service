# Copy this file to .env and set your own DHBW student id.
#
# Example:
#   cp .env.example .env
#   sed -i 's/s000000/deine-id/' .env

STUDENT_ID=s000000

# Optional overrides. Normally these are derived from STUDENT_ID.
# ZONE=s000000-at-student-dhbw-mannheim-de.users.dhbw.site
# REGISTRY=registry.s000000-at-student-dhbw-mannheim-de.users.dhbw.site
# KUBECONFIG=/path/to/translation-service/infra/ansible/kubeconfig-generated.yaml
